# Copy this to .env and fill in real values. .env is git-ignored — never commit it.
# For GitHub Actions, these same values go into repo Settings → Secrets and variables → Actions.

# Read-only market data (currently Alpaca — see marketdata.js). No trading
# account permissions needed, just a free Alpaca account for the data API.
MARKET_DATA_KEY=
MARKET_DATA_SECRET=
MARKET_DATA_BASE_URL=https://paper-api.alpaca.markets/v2
MARKET_DATA_URL=https://data.alpaca.markets/v2

# Capital — set to your real account size. Never read from a live balance.
TOTAL_BUDGET=25000

# Affordability cap: skip option contracts costing more than this per
# contract (premium x 100). Keeps a single expensive contract from eating a
# whole position slot. Symbols priced above it still appear in WARM with
# their real cheapest price, so nothing is hidden. Default 1000.
MAX_PREMIUM_PER_CONTRACT=1000

# Largest share of capital a single position may lose if the option expires
# worthless. This is the real risk control for long options — a stop order
# cannot cap the loss (see EXIT_STRATEGY.md), position size can. 0.02 = 2%.
MAX_LOSS_PER_TRADE_PCT=0.02
MAX_PORTFOLIO_ALLOCATION=6000
WEEKLY_TARGET=750

# Email (Gmail — use an App Password, not your real password)
NOTIFY_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Real Fed funds rate + yield curve data (fred.js) — free key, no cost, sign
# up at https://fred.stlouisfed.org/docs/api/api_key.html. Optional: without
# it, the report just shows the macro section as "not configured" rather
# than guessing a rate.
FRED_API_KEY=
